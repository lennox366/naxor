{
  "name": "ai-developer-studio",
  "version": "0.1.0",
  "description": "AI Developer Studio - Desktop KI Chat & Voice System",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && set ADS_DEV=1&& electron .\"",
    "dev:vite": "vite",
    "electron": "electron .",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.72.0",
    "marked": "^18.2.0",
    "msedge-tts": "^2.1.1",
    "sql.js": "^1.12.0",
    "ws": "^8.23.0"
  },
  "build": {
    "appId": "com.aideveloperstudio.app",
    "productName": "NAXORA",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.0"
  }
}
